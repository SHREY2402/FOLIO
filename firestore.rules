rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only signed-in users can see their own confirmed credit balance.
    match /entitlements/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }
    // Orders are strictly server-managed; never expose order payment metadata to clients.
    match /paymentOrders/{orderId} {
      allow read, write: if false;
    }
    // All other data is private by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
